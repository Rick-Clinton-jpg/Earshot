g up the visitor complexity, the\nradon/visitors.py:188:        functions complexity, and the classes complexity.\nradon/visitors.py:191:            self.complexity\nradon/visitors.py:192:            + self.functions_complexity\nradon/visitors.py:193:            + self.classes_complexity\nradon/visitors.py:232:            self.complexity += len(node.handlers) + bool(node.orelse)\nradon/visitors.py:233:        elif name == 'BoolOp':\nradon/visitors.py:234:            self.complexity += len(node.values) + 1\nradon/visitors.py:238:            self.complexity += 1\nradon/visitors.py:245:            self.complexity += max(0, len(node.cases) - contain_underscore)\nradon/visitors.py:248:            self.complexity += bool(node.orelse) + 1\nradon/visitors.py:252:            self.complexity += len(node.ifs) + 1\nradon/visitors.py:257:        '''When visiting `assert` statements, the complexity is increased only\nradon/visitors.py:260:        self.complexity += not self.no_assert\nradon/visitors.py:272:        # The complexity of a function is computed taking into account\nradon/visitors.py:273:        # the following factors: number of decorators, the complexity\nradon/visitors.py:277:        body_complexity = 1\nradon/visitors.py:282:            # Add general complexity but not closures' complexity, see #68\nradon/visitors.py:283:            body_complexity += visitor.complexity\nradon/visitors.py:293:            body_complexity,\nradon/visitors.py:301:        # The complexity of a class is computed taking into account\nradon/visitors.py:302:        # the following factors: number of decorators and the complexity\nradon/visitors.py:307:        body_complexity = 1\nradon/visitors.py:317:            body_complexity += (\nradon/visitors.py:318:                visitor.complexity\nradon/visitors.py:319:                + visitor.functions_complexity\nradon/visitors.py:332:            body_complexity,\nradon/visitors.py:415:    def visit_BoolOp(self, node):\nradon/visitors.py:416:        '''A boolean operator.'''\nBackground reference for the public maintenance request.\nBackground reference for the public maintenance request.\n[tool.poetry]\nname = \"radon\"\nversion = \"6.0.1\"\ndescription = \"Code Metrics in Python\"\nauthors = [\"Michele Lacchia <michelelacchia@gmail.com>\"]\nlicense = \"MIT\"\nreadme = \"README.rst\"\n\n[tool.poetry.dependencies]\npython = \">=3.7,<4.0\"\nmando = \">=0.6,<0.8\"\ncolorama = [\n    {version = \">=0.4.1\", markers = \"python_version > \\\"3.4\\\"\"},\n    {version = \"==0.4.1\", markers = \"python_version <= \\\"3.4\\\"\"}\n]\n\n[tool.poetry.group.dev.dependencies]\ncoverage = \"*\"\ncoveralls = \"*\"\npytest = [\n    {version = \">=2.7\", markers = \"python_version < \\\"3.0\\\"\"},\n    {version = \">5.0\", markers = \"python_version >= \\\"3.0\\\"\"}\n]\npytest-mock = \"*\"\nargparse = \"*\"\nnbformat = \"*\"\ntox = \"^4.4.7\"\n\n[tool.poetry.scripts]\nradon = \"radon:main\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n[wheel]\nuniversal=1\n","exit_code":0,"status":"completed"}}
