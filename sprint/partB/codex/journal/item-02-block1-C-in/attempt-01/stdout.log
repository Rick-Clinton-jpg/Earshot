{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"pwd; rg --files -g 'AGENTS.md' -g '*test*' -g '*.py' -g '*refs*' -g 'pyproject.toml' -g 'setup.cfg' -g 'tox.ini'\"","aggregated_output":"/private/tmp/esb_401hj1ik/w\nsetup.cfg\ntox.ini\nradon/__main__.py\nradon/contrib/flake8.py\nradon/contrib/__init__.py\nradon/cli/colors.py\nradon/cli/harvest.py\nradon/cli/__init__.py\nradon/cli/tools.py\nradon/__init__.py\nradon/tests/test_other_metrics.py\nradon/tests/test_halstead.py\nradon/tests/test_complexity_visitor.py\nradon/tests/data/no_encoding.py\nradon/tests/data/__init__.py\nradon/tests/data/py3unicode.py\nradon/tests/test_cli.py\nradon/tests/test_raw.py\nradon/tests/test_cli_harvest.py\nradon/tests/test_complexity_utils.py\nradon/tests/test_cli_tools.py\nradon/tests/__init__.py\nradon/tests/test_ipynb.py\nradon/tests/test_cli_colors.py\nradon/tests/conftest.py\nradon/tests/run.py\nradon/complexity.py\nradon/visitors.py\nradon/raw.py\nradon/metrics.py\nsetup.py\ndocs/conf.py\npyproject.toml\ntest_requirements.txt\n","exit_code":0,"status":"completed"}}
