{
  "backend": "claude",
  "cli": "claude",
  "model": "claude-sonnet-5-5",
  "version": "2.1.319",
  "effort": "low",
  "argv": [
    "claude",
    "-p",
    "--model",
    "claude-sonnet-5-5",
    "--effort",
    "low",
    "--setting-sources",
    "",
    "--strict-mcp-config",
    "--disable-slash-commands",
    "--tools",
    "Read,Grep,Glob",
    "--permission-mode",
    "dontAsk",
    "--no-session-persistence",
    "--json-schema",
    "{schema_json}",
    "--output-format",
    "stream-json",
    "--verbose"
  ],
  "output_method": "claude_stream_json",
  "output_method_reviewed": true,
  "sandbox": "Read, Grep and Glob only; dontAsk; the isolation fixture denied its two outside-workspace requests; no universal read-boundary claim",
  "timeout_seconds": 180,
  "workers": 4,
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
